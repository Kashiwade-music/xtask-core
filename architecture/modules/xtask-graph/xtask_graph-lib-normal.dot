digraph {
  graph [label="xtask-graph::xtask_graph (lib, normal): module dependencies", labelloc="t", rankdir="LR", newrank=true];
  node [shape="box"];
  "crate" [label="(self)"];
  "crate::layout" [label="(self)"];
  "crate::model" [label="(self)"];
  "crate::wave" [label="(self)"];
  subgraph "cluster_crate" {
    label="crate";
    "crate";
    subgraph "cluster_crate::layout" {
      label="crate::layout";
      "crate::layout";
    }
    subgraph "cluster_crate::model" {
      label="crate::model";
      "crate::model";
    }
    subgraph "cluster_crate::wave" {
      label="crate::wave";
      "crate::wave";
    }
  }
  "crate" -> "crate::layout";
  "crate" -> "crate::model";
  "crate" -> "crate::wave";
  "crate::layout" -> "crate::model";
}
